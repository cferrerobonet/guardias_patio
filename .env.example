# Configuración de la aplicación Guardias de Patio
# Copiar este archivo a .env y ajustar valores según necesidad

# ========== APLICACIÓN ==========
GUARDIAS_APP_NAME="Gestión de Guardias de Patio"
GUARDIAS_APP_VERSION="3.0.0"
GUARDIAS_ENVIRONMENT="production"  # development, production, testing

# ========== BASE DE DATOS ==========
GUARDIAS_DATABASE_URL="sqlite:///guardias_patio.db"
GUARDIAS_DATABASE_ECHO=false  # true para ver SQL queries
GUARDIAS_POOL_SIZE=5
GUARDIAS_MAX_OVERFLOW=10

# ========== LOGGING ==========
GUARDIAS_LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
GUARDIAS_LOG_FILE="logs/guardias_patio.log"
GUARDIAS_LOG_TO_CONSOLE=true
GUARDIAS_LOG_TO_FILE=true
GUARDIAS_STRUCTURED_LOGGING=true  # JSON logs

# ========== CACHE ==========
GUARDIAS_CACHE_ENABLED=true
GUARDIAS_CACHE_TTL=300  # 5 minutos
GUARDIAS_CACHE_MAX_SIZE=1000

# ========== PERFORMANCE ==========
GUARDIAS_ENABLE_QUERY_OPTIMIZATION=true
GUARDIAS_ENABLE_EAGER_LOADING=true
GUARDIAS_BATCH_SIZE=100

# ========== FEATURES (habilitar/deshabilitar funcionalidades) ==========
GUARDIAS_FEATURE_ZONA_PREFERIDA=true
GUARDIAS_FEATURE_MATRIZ_HORARIO=true
GUARDIAS_FEATURE_AUSENCIAS=true
GUARDIAS_FEATURE_SUSTITUCIONES=true
GUARDIAS_FEATURE_EXPORTACION=true

# ========== DESARROLLO ==========
GUARDIAS_DEBUG=false
GUARDIAS_ENABLE_PROFILING=false
GUARDIAS_ENABLE_METRICS=false

# ========== VALIDACIÓN Y LÍMITES ==========
GUARDIAS_MAX_GUARDIAS_POR_PROFESOR_DIA=1  # Máximo de guardias por profesor por día
GUARDIAS_MAX_HORAS_CONTRATO=40.0
GUARDIAS_MIN_HORAS_CONTRATO=1.0
