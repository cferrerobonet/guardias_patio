{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git tag *)",
      "Bash(git push*)",
      "Bash(git stash *)",
      "Bash(python -m pytest tests/ --tb=no -q)",
      "Bash(python -m pytest tests/ --tb=line -q)",
      "Bash(python -m pytest tests/ --tb=short -q)",
      "Bash(python -m pytest tests/ -x --tb=no -q)",
      "Bash(python -m pytest tests/ -x --tb=short -q)",
      "Bash(/opt/homebrew/bin/python3.11 -m pytest *)",
      "Bash(/opt/homebrew/bin/python3.11 -m ruff *)",
      "Bash(/opt/homebrew/bin/python3.11 -m bandit *)",
      "Bash(/opt/homebrew/bin/python3.11 -m mypy *)",
      "Bash(QT_QPA_PLATFORM=offscreen *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(cat *)",
      "Bash(make test*)",
      "Bash(make bench)",
      "Bash(~/.venvs/guardias-patio/bin/python -m pytest *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m ruff *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m bandit *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m mypy *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m pip_audit *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m radon *)",
      "Bash(~/.venvs/guardias-patio/bin/python -m vulture *)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "R=\"$(git rev-parse --show-toplevel)\"; P=~/.venvs/guardias-patio/bin/python; [ -x \"$P\" ] || P=\"$(command -v python3 || command -v python)\"; [ -n \"$P\" ] || exit 0; \"$P\" \"$R/.claude/hooks/compilar_py.py\""
          }
        ]
      }
    ]
  }
}
