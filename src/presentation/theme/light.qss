/* ========== GLOBAL ========== */
QWidget {
    font-family: @FONT_FAMILY@;
    font-size: 14px;
    color: @TEXT_PRIMARY@;
}

/* ========== BOTONES GENERALES ========== */
QPushButton {
    background-color: @PRIMARY@;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    min-height: 32px;
}

QPushButton:hover {
    background-color: @PRIMARY_DARK@;
}

QPushButton:pressed {
    background-color: @PRIMARY_DARK@;
}

QPushButton:disabled {
    background-color: @BORDER_DARK@;
    color: @TEXT_DISABLED@;
}

/* ========== SECUNDARIOS ========== */
QPushButton#secondaryButton {
    background-color: transparent;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DARK@;
}

QPushButton#secondaryButton:hover {
    background-color: @SURFACE@;
    border-color: @SECONDARY@;
}

/* ========== BOTONES DE ÉXITO Y PELIGRO ========== */
QPushButton[success="true"] {
    background-color: #28A745;
    color: white;
}
QPushButton[success="true"]:hover {
    background-color: #218838;
}
QPushButton[danger="true"] {
    background-color: @ERROR@;
    color: white;
}
QPushButton[danger="true"]:hover {
    background-color: #C82333;
}

/* ========== INPUTS ========== */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: @BACKGROUND@;
    color: @TEXT_PRIMARY@;
    padding: 8px 12px;
    border: 1px solid @BORDER_DARK@;
    border-radius: 4px;
    min-height: 28px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @PRIMARY@;
}

/* ========== COMBOBOX ========== */
QComboBox {
    background-color: @BACKGROUND@;
    color: @TEXT_PRIMARY@;
    padding: 8px 12px;
    border: 1px solid @BORDER_DARK@;
    border-radius: 4px;
}

QComboBox:hover {
    border-color: @SECONDARY@;
}

QComboBox:focus {
    border-color: @PRIMARY@;
}

QComboBox QAbstractItemView {
    background-color: @BACKGROUND@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER_DARK@;
    selection-background-color: @PRIMARY_LIGHT@;
    selection-color: @TEXT_PRIMARY@;
}

/* ========== TABLAS ========== */
QTableWidget, QTableView {
    background-color: @BACKGROUND@;
    alternate-background-color: @SURFACE@;
    gridline-color: @BORDER@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 4px;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: @PRIMARY_LIGHT@;
    color: @TEXT_PRIMARY@;
}

QHeaderView::section {
    background-color: @SURFACE@;
    color: @TEXT_PRIMARY@;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 2px solid @BORDER@;
}

/* ========== SIDEBAR ========== */
QWidget#sidebar {
    background-color: @SIDEBAR_BG@;
    border-right: 1px solid @SIDEBAR_BORDER@;
}

QLabel#sidebarTitle {
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 12px;
}

QLabel#menuCategory {
    color: rgba(255, 255, 255, 0.75);
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    padding: 12px 16px 4px 16px;
    margin-top: 20px;
}

QPushButton#menuButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    text-align: left;
    margin: 2px 12px;
}

QPushButton#menuButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: white;
}

QPushButton#menuButtonActive {
    background-color: @PRIMARY@;
    color: white;
    font-weight: bold;
    text-align: left;
    margin: 2px 12px;
}

/* ========== LABELS ========== */
QLabel#heading1 {
    font-size: 28px;
    font-weight: bold;
}
QLabel#heading2 {
    font-size: 24px;
    font-weight: 600;
}
QLabel#heading3 {
    font-size: 20px;
    font-weight: 600;
}
QLabel#secondary {
    color: @SECONDARY@;
    font-size: 12px;
}

/* ========== LABELS DE FORMULARIO ========== */
QLabel#fieldLabel {
    font-size: 13px;
    font-weight: bold;
    color: #212121;
    margin-bottom: 4px;
    margin-top: 8px;
}

QLabel#smallFieldLabel {
    font-size: 12px;
    font-weight: bold;
    color: #212121;
    margin-bottom: 1px;
    margin-top: 8px;
}

QLabel#titleMain {
    font-size: 18px;
    font-weight: bold;
    color: @PRIMARY@;
    background-color: #f5f5f5;
    padding: 9px 14px;
    border-left: 4px solid @PRIMARY@;
    border-radius: 4px;
    margin-bottom: 8px;
    min-height: 24px;
}

/* ========== GROUPBOX ========== */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    color: @PRIMARY@;
    border: 2px solid #e0e0e0;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 14px;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 12px;
    left: 12px;
    top: -2px;
    background-color: #f5f5f5;
    border-radius: 4px;
    color: @TEXT_PRIMARY@;
}

/* ========== MESSAGEBOX ========== */
QMessageBox {
    background-color: white;
    min-width: 400px;
}

QMessageBox QLabel {
    color: @TEXT_PRIMARY@;
    font-size: 14px;
    padding: 10px;
}

QMessageBox QPushButton {
    background-color: @SUCCESS_DARK@;
    color: white;
    font-weight: 600;
    font-size: 13px;
    padding: 8px 24px;
    border: 2px solid #047857;
    border-radius: 6px;
    min-width: 100px;
    min-height: 35px;
}

QMessageBox QPushButton:hover {
    background-color: #047857;
}

QMessageBox QPushButton:pressed {
    background-color: #065f46;
}

QMessageBox QPushButton:default {
    background-color: #0284c7;
    border: 2px solid #0369a1;
}

QMessageBox QPushButton:default:hover {
    background-color: #0369a1;
}

/* ========== BOTÓN WARNING ========== */
QPushButton[warning="true"] {
    background-color: #FF9800;
    color: white;
    font-weight: bold;
}

QPushButton[warning="true"]:hover {
    background-color: #e68900;
}

QPushButton[warning="true"]:pressed {
    background-color: #cc7a00;
}

/* ========== TERMINAL RETRO ========== */
QTextEdit#terminalRetro {
    background-color: #3C3C3C;
    color: #00FF00;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 12px;
    padding: 12px;
    border: 2px solid #555555;
    border-radius: 4px;
    selection-background-color: #2A4A2A;
    selection-color: #00FF00;
}

/* ========== INPUTS READ-ONLY ========== */
QLineEdit:read-only, QDateEdit:read-only, QTimeEdit:read-only {
    background-color: #f5f5f5;
    color: #757575;
    border-color: #e0e0e0;
}

/* ========== SCROLL AREA ========== */
QScrollArea {
    border: none;
}

/* ========== LABELS COMUNES EN FORMULARIOS/DIÁLOGOS ========== */
/* Etiqueta descriptiva secundaria (desc/descripcion widgets) */
QLabel#formDescription {
    color: #666666;
    font-size: 12px;
    margin-bottom: 10px;
}

/* Título de diálogo pequeño (14px bold) */
QLabel#dialogTitle {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 10px;
}

/* Título de sección modal (16px bold azul) */
QLabel#modalSectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2196F3;
}

/* Separador horizontal gris */
QFrame#separator {
    background-color: #ccc;
    max-height: 1px;
}

/* Label de advertencia de cambios sin guardar */
QLabel#unsavedChanges {
    color: #e67e22;
    font-weight: bold;
}
