"""
Formulario Profesional de Gestión de Perfiles de Usuario - CRUD Completo.

CRUD Profesional con:
- Tabla moderna con iconos y colores
- Modales de confirmación elegantes
- Botones con iconos SVG
- Validaciones completas
- Gestión de logos corporativos
- Cambio de contraseña seguro
"""

from pathlib import Path

import ui_styles as styles
from application.use_cases.perfil import (
    ActualizarLogoUseCase,
    ActualizarPerfilUseCase,
    CambiarPasswordUseCase,
    CrearPerfilUseCase,
    EliminarPerfilUseCase,
    ListarPerfilesUseCase,
)
from core.exceptions import NotFoundError, ValidationError
from database.db_manager import get_current_user_id
from PyQt6.QtCore import Qt
from PyQt6.QtWidgets import (
    QFileDialog,
    QHBoxLayout,
    QHeaderView,
    QLabel,
    QMessageBox,
    QPushButton,
    QTableWidget,
    QTableWidgetItem,
    QVBoxLayout,
    QWidget,
)
from sqlalchemy.orm import Session
from sync.sync_manager import UserAuth

from presentation.dialogs.modales_perfil import (
    DialogoCambiarPasswordProfesional,
    DialogoCrearPerfilProfesional,
    DialogoEditarPerfilProfesional,
)
from presentation.forms.base_form import BaseForm


class PerfilesUsuarioForm(BaseForm):
    """
    Formulario para gestionar perfiles de usuario.
    
    Gestiona:
    - Perfil actual del usuario logueado
    - Tabla con todos los perfiles del sistema
    - CRUD completo de perfiles
    - Logos/avatares corporativos
    - Bases de datos asociadas
    """

    def __init__(self, session: Session, parent=None):
        """
        Inicializa el formulario de perfiles.
        
        Args:
            session: Sesión de SQLAlchemy
            parent: Widget padre
        """
        super().__init__(session, parent)
        
        self.user_auth = UserAuth()
        self.current_username = get_current_user_id()
        
        self.setup_ui()
        self.cargar_perfiles()

    def setup_ui(self) -> None:
        """Configura la interfaz de usuario."""
        self.setWindowTitle("Perfiles de Usuario")

        # Layout principal
        main_layout = QVBoxLayout()
        main_layout.setContentsMargins(0, 0, 0, 0)

        # Scroll area
        scroll_area = QScrollArea()
        scroll_area.setWidgetResizable(True)
        scroll_area.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)
        scroll_area.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAsNeeded)

        # Widget contenedor
        content_widget = QWidget()
        content_layout = QVBoxLayout()
        content_layout.setContentsMargins(20, 20, 20, 20)
        content_layout.setSpacing(15)

        # Título principal
        titulo = QLabel("👤 PERFILES DE USUARIO")
        titulo.setStyleSheet(styles.STYLE_TITLE_MAIN)
        content_layout.addWidget(titulo)

        # ===== SECCIÓN 1: Mi Perfil Actual =====
        self.perfil_widget = PerfilUsuarioWidget(
            self, 
            user_auth=self.user_auth, 
            current_username=self.current_username
        )
        self.perfil_widget.password_change_requested.connect(self.cambiar_contrasena)
        content_layout.addWidget(self.perfil_widget)

        # ===== SECCIÓN 2: Gestión de Perfiles =====
        gestion_grupo = QGroupBox("🗂️ Gestión de Todos los Perfiles")
        gestion_grupo.setStyleSheet(styles.STYLE_GROUPBOX)
        gestion_layout = QVBoxLayout()
        gestion_layout.setSpacing(10)
        gestion_layout.setContentsMargins(15, 15, 15, 15)

        # Descripción
        desc_label = QLabel(
            "Administra todos los perfiles del sistema. Cada perfil tiene su propia "
            "base de datos y configuración independiente."
        )
        desc_label.setWordWrap(True)
        desc_label.setStyleSheet("color: #666; font-size: 10px; margin-bottom: 5px;")
        gestion_layout.addWidget(desc_label)

        # Botones de acción
        botones_layout = QHBoxLayout()
        botones_layout.setSpacing(8)

        btn_crear = QPushButton("➕ Crear Perfil")
        btn_crear.setStyleSheet(styles.STYLE_BUTTON_SUCCESS + "font-size: 11px; padding: 6px 12px;")
        btn_crear.clicked.connect(self.crear_perfil)
        botones_layout.addWidget(btn_crear)

        btn_editar = QPushButton("✏️ Editar Seleccionado")
        btn_editar.setStyleSheet(styles.STYLE_BUTTON_PRIMARY + "font-size: 11px; padding: 6px 12px;")
        btn_editar.clicked.connect(self.editar_perfil)
        botones_layout.addWidget(btn_editar)

        btn_logo = QPushButton("🖼️ Cambiar Logo")
        btn_logo.setStyleSheet(styles.STYLE_BUTTON_PRIMARY + "font-size: 11px; padding: 6px 12px;")
        btn_logo.clicked.connect(self.cambiar_logo_perfil)
        botones_layout.addWidget(btn_logo)

        btn_eliminar = QPushButton("🗑️ Eliminar")
        btn_eliminar.setStyleSheet(styles.STYLE_BUTTON_DANGER + "font-size: 11px; padding: 6px 12px;")
        btn_eliminar.clicked.connect(self.eliminar_perfil)
        botones_layout.addWidget(btn_eliminar)

        btn_refrescar = QPushButton("🔄 Refrescar")
        btn_refrescar.setStyleSheet("""
            QPushButton {
                background-color: #607D8B;
                color: white;
                border: none;
                padding: 6px 12px;
                border-radius: 4px;
                font-weight: bold;
                font-size: 11px;
            }
            QPushButton:hover {
                background-color: #546E7A;
            }
        """)
        btn_refrescar.clicked.connect(self.cargar_perfiles)
        botones_layout.addWidget(btn_refrescar)

        botones_layout.addStretch()
        gestion_layout.addLayout(botones_layout)

        # Tabla de perfiles
        self.tabla_perfiles = QTableWidget()
        self.tabla_perfiles.setColumnCount(5)
        self.tabla_perfiles.setHorizontalHeaderLabels([
            "Usuario", "Email", "Tiene BD", "Logo", "Actual"
        ])
        
        header = self.tabla_perfiles.horizontalHeader()
        header.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        header.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        header.setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        header.setSectionResizeMode(3, QHeaderView.ResizeMode.ResizeToContents)
        header.setSectionResizeMode(4, QHeaderView.ResizeMode.ResizeToContents)
        
        self.tabla_perfiles.setSelectionBehavior(QTableWidget.SelectionBehavior.SelectRows)
        self.tabla_perfiles.setSelectionMode(QTableWidget.SelectionMode.SingleSelection)
        self.tabla_perfiles.setAlternatingRowColors(True)
        self.tabla_perfiles.setMinimumHeight(250)
        
        gestion_layout.addWidget(self.tabla_perfiles)

        gestion_grupo.setLayout(gestion_layout)
        content_layout.addWidget(gestion_grupo)

        # Espacio flexible
        content_layout.addStretch()

        # Establecer layouts
        content_widget.setLayout(content_layout)
        scroll_area.setWidget(content_widget)
        main_layout.addWidget(scroll_area)

        self.setLayout(main_layout)

    def cargar_perfiles(self):
        """Carga todos los perfiles en la tabla."""
        self.tabla_perfiles.setRowCount(0)
        
        if not self.user_auth or not self.user_auth.users:
            return
        
        for username, data in self.user_auth.users.items():
            row = self.tabla_perfiles.rowCount()
            self.tabla_perfiles.insertRow(row)
            
            # Usuario
            self.tabla_perfiles.setItem(row, 0, QTableWidgetItem(username))
            
            # Email
            email = data.get("email", "")
            self.tabla_perfiles.setItem(row, 1, QTableWidgetItem(email))
            
            # Tiene BD
            tiene_bd = "✅ Sí" if user_has_database(username) else "❌ No"
            item_bd = QTableWidgetItem(tiene_bd)
            item_bd.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
            self.tabla_perfiles.setItem(row, 2, item_bd)
            
            # Logo
            logo_path = Path("imagenes") / f"{username}.png"
            tiene_logo = "🖼️" if logo_path.exists() else "➖"
            item_logo = QTableWidgetItem(tiene_logo)
            item_logo.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
            self.tabla_perfiles.setItem(row, 3, item_logo)
            
            # Es el actual
            es_actual = "⭐" if username == self.current_username else ""
            item_actual = QTableWidgetItem(es_actual)
            item_actual.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
            self.tabla_perfiles.setItem(row, 4, item_actual)

    def crear_perfil(self):
        """Crea un nuevo perfil de usuario."""
        from presentation.dialogs.dialogo_crear_perfil import DialogoCrearPerfil
        
        dialogo = DialogoCrearPerfil(self.user_auth, self)
        if dialogo.exec():
            self.cargar_perfiles()
            QMessageBox.information(
                self,
                "Perfil Creado",
                "El perfil se ha creado correctamente con su base de datos asociada."
            )

    def editar_perfil(self):
        """Edita el perfil seleccionado."""
        row = self.tabla_perfiles.currentRow()
        if row < 0:
            QMessageBox.warning(self, "Advertencia", "Selecciona un perfil para editar")
            return
        
        username = self.tabla_perfiles.item(row, 0).text()
        
        from presentation.dialogs.dialogo_editar_perfil import DialogoEditarPerfil
        
        dialogo = DialogoEditarPerfil(self.user_auth, username, self)
        if dialogo.exec():
            self.cargar_perfiles()
            QMessageBox.information(self, "Perfil Actualizado", "Los cambios se han guardado correctamente.")

    def cambiar_logo_perfil(self):
        """Cambia el logo/avatar del perfil seleccionado."""
        row = self.tabla_perfiles.currentRow()
        if row < 0:
            QMessageBox.warning(self, "Advertencia", "Selecciona un perfil para cambiar su logo")
            return
        
        username = self.tabla_perfiles.item(row, 0).text()
        
        # Seleccionar imagen
        archivo, _ = QFileDialog.getOpenFileName(
            self,
            "Seleccionar Logo Corporativo",
            "",
            "Imágenes (*.png *.jpg *.jpeg *.bmp)"
        )
        
        if not archivo:
            return
        
        try:
            # Copiar imagen a carpeta imagenes con nombre del usuario
            destino = Path("imagenes") / f"{username}.png"
            destino.parent.mkdir(exist_ok=True)
            
            shutil.copy(archivo, destino)
            
            self.cargar_perfiles()
            QMessageBox.information(
                self,
                "Logo Actualizado",
                f"El logo del perfil '{username}' se ha actualizado correctamente."
            )
        except Exception as e:
            QMessageBox.critical(
                self,
                "Error",
                f"No se pudo actualizar el logo:\n{str(e)}"
            )

    def eliminar_perfil(self):
        """Elimina el perfil seleccionado y su base de datos."""
        row = self.tabla_perfiles.currentRow()
        if row < 0:
            QMessageBox.warning(self, "Advertencia", "Selecciona un perfil para eliminar")
            return
        
        username = self.tabla_perfiles.item(row, 0).text()
        
        # No permitir eliminar el perfil actual
        if username == self.current_username:
            QMessageBox.warning(
                self,
                "No Permitido",
                "No puedes eliminar tu propio perfil mientras estás logueado."
            )
            return
        
        # Confirmar eliminación
        respuesta = QMessageBox.question(
            self,
            "Confirmar Eliminación",
            f"¿Estás seguro de eliminar el perfil '{username}'?\n\n"
            f"⚠️ ADVERTENCIA: Se eliminará:\n"
            f"• El perfil de usuario\n"
            f"• Su base de datos (si existe)\n"
            f"• Su logo corporativo (si existe)\n\n"
            f"Esta acción NO se puede deshacer.",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No
        )
        
        if respuesta != QMessageBox.StandardButton.Yes:
            return
        
        try:
            # Eliminar base de datos
            if user_has_database(username):
                delete_user_database(username)
            
            # Eliminar logo
            logo_path = Path("imagenes") / f"{username}.png"
            if logo_path.exists():
                logo_path.unlink()
            
            # Eliminar perfil
            if username in self.user_auth.users:
                del self.user_auth.users[username]
                self.user_auth.save_users()
            
            self.cargar_perfiles()
            QMessageBox.information(
                self,
                "Perfil Eliminado",
                f"El perfil '{username}' y todos sus datos han sido eliminados correctamente."
            )
        except Exception as e:
            QMessageBox.critical(
                self,
                "Error",
                f"No se pudo eliminar el perfil:\n{str(e)}"
            )

    def cambiar_contrasena(self):
        """Cambia la contraseña del perfil actual."""
        from presentation.forms.change_password_dialog import ChangePasswordDialog
        
        dialog = ChangePasswordDialog(self.current_username, self.user_auth, self)
        dialog.exec()

    def refrescar(self):
        """Refresca los datos del formulario."""
        self.cargar_perfiles()
