Options -Indexes -MultiViews
DirectoryIndex index.html
# Ningún fichero oculto (.env, .htaccess…) se sirve
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# …ni ninguna carpeta oculta (.git…), salvo .well-known (certificados)
RedirectMatch 404 "/\.(?!well-known/)"
# config.php solo lo carga api/hoy.php por PHP, nunca por la web
<Files "config.php">
  Require all denied
</Files>
<IfModule mod_headers.c>
  # Cabeceras de seguridad. Se abre en el navegador de una smart TV y no la incrusta nadie:
  # frame-ancestors es la única directiva de la CSP (no limita scripts, estilos ni fuentes).
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  <FilesMatch "\.(html|js|css|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
