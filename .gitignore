# ============================================================================
# .gitignore - Configuración Conservadora
# Solo ignora archivos que NO son parte del proyecto y pueden regenerarse
# ============================================================================

# Entornos Virtuales de Python (se crean con: python -m venv .venv)
venv/
.venv/
env/
ENV/

# Archivos compilados de Python (se regeneran automáticamente)
__pycache__/
*.py[cod]
*$py.class
*.so

# Cachés de herramientas (se regeneran automáticamente)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDEs y Editores (configuraciones locales del usuario)
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Sistema Operativo
.DS_Store
**/. DS_Store
Thumbs.db
desktop.ini

# Variables de entorno locales (¡pueden contener secretos!)
.env
.env.local
*.env

# Base de datos de desarrollo (se regenera con: alembic upgrade head)
guardias_patio.db
*.db

# Archivos temporales de SQLite en modo WAL
*.db-shm
*.db-wal

# Archivos de sincronización y sesión
session.lock
last_sync.json
**/last_sync.json  # En cualquier subdirectorio
guardias_patio_data.json
**/guardias_patio_data.json  # En cualquier subdirectorio

# Archivos de demostración y testing (obsoletos tras Sprint 12)
demo_*.py

# Reportes de cobertura de tests
coverage.xml
.coverage
htmlcov/

# Logs de desarrollo
logs/
*.log
regeneracion*.log
test_v3_output.log
benchmark_results.log

# Build y distribución (PyInstaller, DMG, EXE)
build/
dist/
*.dmg
*.exe
*.spec
checksums*.txt
imagenes/*.iconset
Output/  # Directorio de salida de Inno Setup

# Archivos históricos comprimidos (muy grandes para git)
ARCHIVO_HISTORICO_*.tar.gz
ARCHIVO_HISTORICO_*.zip

# PDFs generados como ejemplos o pruebas
documentacion/datos ejemplo/*.pdf
Calendario_*.pdf

# ============================================================================
# NOTA IMPORTANTE: 
# Los siguientes archivos SÍ se suben a Git (NO están en .gitignore):
# 
# ✅ src/**/*.py                - Código fuente de la aplicación
# ✅ tests/**/*.py              - Tests del proyecto (44+ tests)
# ✅ documentacion/**/*         - Documentación completa
# ✅ alembic/versions/*.py      - Migraciones de base de datos
# ✅ requirements.txt           - Dependencias del proyecto
# ✅ pyproject.toml             - Configuración del proyecto
# ✅ *.sh                       - Scripts de ejecución
# ✅ imagenes/*                 - Imágenes del proyecto
# ✅ .coveragerc, pytest.ini    - Configuración de herramientas
# 
# ❌ guardias_patio.db          - Base de datos (se regenera localmente)
# ❌ demo_*.py                  - Archivos de demo (obsoletos tras Sprint 12)
# ❌ htmlcov/, coverage.xml     - Reportes de cobertura (se regeneran)
# ❌ __pycache__/, *.pyc        - Archivos compilados (se regeneran)
# ============================================================================
